#!/usr/bin/env jenkinsfile
// ================================================================================
// Odoo Multi-Version Deployment - Unified Jenkinsfile
// يدعم Odoo 17 و Odoo 19 مع instanciestين لكل إصدار
// ================================================================================

properties([
    parameters([
        choice(name: 'ODOO_VERSION', choices: ['odoo17', 'odoo19'], description: 'اختر إصدار Odoo المراد نشره'),
        string(name: 'ODOO_ADMIN_PASSWORD', description: 'كلمة مرور المشرف على Odoo', trim: true),
        string(name: 'POSTGRES_PASSWORD', description: 'كلمة مرور PostgreSQL', trim: true)
    ])
])

pipeline {
    agent any

    environment {
        REPO_URL = 'https://github.com/your-org/Odoo-MultiVersion-Deployment.git'
        REPO_CREDENTIALS = 'github-credentials'
        PROJECT_ROOT = '/opt/Odoo-MultiVersion-Deployment'
    }

    options {
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout GitHub') {
            steps {
                checkout([$class: 'GitSCM', branches: [[name: '*/main']],
                         userRemoteConfigs: [[credentialsId: env.REPO_CREDENTIALS, url: env.REPO_URL]])
            }
        }

        stage('Pre-Deployment Validation') {
            steps {
                sh '''
                    set -e
                    docker --version
                    docker compose version
                    docker network inspect proxy >/dev/null 2>&1 || docker network create --driver bridge --subnet 172.28.0.0/16 proxy
                    df -h /opt /data
                    free -h
                    if [ "${ODOO_VERSION}" = "odoo17" ]; then
                        mkdir -p /opt/odoo17 /data/odoo17 /data/backups/odoo17
                        mkdir -p /data/odoo17/instance1/postgresql /data/odoo17/instance2/postgresql
                        mkdir -p /opt/odoo17/instance1/etc /opt/odoo17/instance1/addons
                        mkdir -p /opt/odoo17/instance2/etc /opt/odoo17/instance2/addons
                    else
                        mkdir -p /opt/odoo19 /data/odoo19 /data/backups/odoo19
                        mkdir -p /data/odoo19/instance1/postgresql /data/odoo19/instance2/postgresql
                        mkdir -p /opt/odoo19/instance1/etc /opt/odoo19/instance1/addons
                        mkdir -p /opt/odoo19/instance2/etc /opt/odoo19/instance2/addons
                    fi
                '''
            }
        }

        stage('Ansible Preparation') {
            steps {
                sh '''
                    set -e
                    ansible-galaxy collection install -r requirements.yml
                    if [ "${ODOO_VERSION}" = "odoo17" ]; then
                        test -f versions/odoo17.yml || { echo "ERROR: versions/odoo17.yml غير موجود"; exit 1; }
                    else
                        test -f versions/odoo19.yml || { echo "ERROR: versions/odoo19.yml غير موجود"; exit 1; }
                    fi
                '''
            }
        }

        stage('Secrets Configuration') {
            steps {
                withCredentials([string(credentialsId: 'ansible-vault-password', variable: 'VAULT_PASS'),
                                 string(credentialsId: 'odoo-admin-password', variable: 'ODOO_ADMIN_PASS'),
                                 string(credentialsId: 'odoo-postgres-password', variable: 'POSTGRES_PASS')]) {
                    sh '''
                        set -e
                        cat > group_vars/vault.yml <<EOF
                        vault_odoo_admin_password: "${ODOO_ADMIN_PASS}"
                        vault_postgres_password: "${POSTGRES_PASS}"
                        EOF
                        echo "${VAULT_PASS}" > /tmp/.vault_pass; chmod 600 /tmp/.vault_pass
                        ansible-vault encrypt group_vars/vault.yml --vault-password-file /tmp/.vault_pass
                        rm -f /tmp/.vault_pass
                    '''
                }
            }
        }

        stage('Docker Deployment') {
            steps {
                withCredentials([string(credentialsId: 'ansible-vault-password', variable: 'VAULT_PASS'),
                                 string(credentialsId: 'odoo-admin-password', variable: 'ODOO_ADMIN_PASS'),
                                 string(credentialsId: 'odoo-postgres-password', variable: 'POSTGRES_PASS')]) {
                    sh '''
                        set -e
                        echo "${VAULT_PASS}" > /tmp/.vault_pass; chmod 600 /tmp/.vault_pass
                        if [ "${ODOO_VERSION}" = "odoo17" ]; then
                            ansible-playbook -i ansible/inventory/hosts.ini \\
                                -e @versions/odoo17.yml \\
                                -e vault_odoo_admin_password="${ODOO_ADMIN_PASS}" \\
                                -e vault_postgres_password="${POSTGRES_PASS}" \\
                                --vault-password-file /tmp/.vault_pass \\
                                ansible/playbooks/install-odoo17.yml
                        else
                            ansible-playbook -i ansible/inventory/hosts.ini \\
                                -e @versions/odoo19.yml \\
                                -e vault_odoo_admin_password="${ODOO_ADMIN_PASS}" \\
                                -e vault_postgres_password="${POSTGRES_PASS}" \\
                                --vault-password-file /tmp/.vault_pass \\
                                ansible/playbooks/install-odoo19.yml
                        fi
                        rm -f /tmp/.vault_pass
                    '''
                }
            }
        }

        stage('Health Checks') {
            steps {
                script {
                    def instances = ['instance1', 'instance2']
                    def failed = []
                    def port_http = 8069
                    def port_chat = 8072
                    for (inst in instances) {
                        try {
                            sh script: "${PROJECT_ROOT}/scripts/health-check.sh ${inst} ${port_http} ${port_chat}", returnStatus: true
                        } catch (Exception e) {
                            failed.add(inst)
                        }
                    }
                    if (!failed.isEmpty()) error("فشل في النسخ: ${failed.join(', ')}")
                }
            }
        }

        stage('Deployment Report') {
            steps {
                sh '''
                    if [ "${ODOO_VERSION}" = "odoo17" ]; then
                        docker ps --filter "name=odoo17" --format "table {{.Names}}\t{{.Status}}"
                        echo "✓ تم نشر Odoo 17 بنجاح"
                        echo "https://odoo1.devops-odoo.com"
                        echo "https://odoo2.devops-odoo.com"
                    else
                        docker ps --filter "name=odoo19" --format "table {{.Names}}\t{{.Status}}"
                        echo "✓ تم نشر Odoo 19 بنجاح"
                        echo "https://odoo19-1.devops-odoo.com"
                        echo "https://odoo19-2.devops-odoo.com"
                    fi
                '''
            }
        }
    }

    post {
        success {
            mail to: 'admin@yourdomain.com',
                 subject: "نجاح نشر Odoo ${ODOO_VERSION} - بناء ${env.BUILD_NUMBER}",
                 body: "تم نشر نسختي Odoo ${ODOO_VERSION} بنجاح."
        }
        failure {
            mail to: 'admin@yourdomain.com',
                 subject: "فشل نشر Odoo ${ODOO_VERSION} - بناء ${env.BUILD_NUMBER}",
                 body: "فشل نشر Odoo ${ODOO_VERSION}."
        }
        always {
            archiveArtifacts artifacts: 'ansible/**, versions/**, scripts/**, requirements.yml', allowEmptyArchive: true
        }
    }
}