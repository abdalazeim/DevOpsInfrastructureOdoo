# ==============================================================================
# Odoo 17 Multi-Instance Docker Compose Template (Jinja2)
# PostgreSQL 16 - PGDATA: /var/lib/postgresql/data
# ==============================================================================
version: '3.8'

services:
  db:
    container_name: {{ item.container_name }}-db
    image: {{ postgres_image }}
    user: "999:999"
    restart: always
    environment:
      - POSTGRES_USER={{ item.db_user }}
      - POSTGRES_PASSWORD={{ item.db_password }}
      - POSTGRES_DB={{ item.db_name }}
    volumes:
      - {{ item.data_path }}/postgresql:/var/lib/postgresql/data
    networks:
      - internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ item.db_user }} -d {{ item.db_name }}"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s

  odoo:
    container_name: {{ item.container_name }}
    image: {{ odoo_image }}
    user: "999:999"
    depends_on:
      db:
        condition: service_healthy
    restart: always
    tty: true
    command: ["--config=/etc/odoo/odoo.conf"]
    environment:
      - HOST={{ item.container_name }}-db
      - PORT=5432
      - USER={{ item.db_user }}
      - PASSWORD={{ item.db_password }}
    {% if traefik_enabled %}
    networks:
      - internal
      - proxy
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ proxy_network }}"
      - "traefik.http.routers.{{ item.container_name }}.rule=Host(`{{ item.domain }}`)"
      - "traefik.http.routers.{{ item.container_name }}.entrypoints=websecure"
      - "traefik.http.routers.{{ item.container_name }}.tls=true"
      - "traefik.http.routers.{{ item.container_name }}.tls.certresolver={{ certresolver }}"
      - "traefik.http.services.{{ item.container_name }}.loadbalancer.server.port=8069"
      - "traefik.http.routers.{{ item.container_name }}-websocket.rule=Host(`{{ item.domain }}`) && PathPrefix(`/websocket`)"
      - "traefik.http.routers.{{ item.container_name }}-websocket.entrypoints=websecure"
      - "traefik.http.routers.{{ item.container_name }}-websocket.tls=true"
      - "traefik.http.routers.{{ item.container_name }}-websocket.tls.certresolver={{ certresolver }}"
      - "traefik.http.routers.{{ item.container_name }}-websocket.priority=100"
      - "traefik.http.services.{{ item.container_name }}-websocket.loadbalancer.server.port=8072"
    {% else %}
    ports:
      - "{{ item.http_port }}:8069"
      - "{{ item.chat_port }}:8072"
    networks:
      - internal
    {% endif %}
    volumes:
      - ./entrypoint.sh:/entrypoint.sh:ro
      - ./addons:/mnt/extra-addons
      - ./etc:/etc/odoo
    environment:
      - ODOO_RC=/etc/odoo/odoo.conf
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h {{ item.container_name }}-db -U {{ item.db_user }} -d {{ item.db_name }} || curl -sf http://localhost:8069/web/database/selector || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s

networks:
  internal:
    name: {{ item.internal_network }}
    driver: bridge
  {% if traefik_enabled %}
  proxy:
    external: true
    name: {{ proxy_network }}
  {% endif %}
