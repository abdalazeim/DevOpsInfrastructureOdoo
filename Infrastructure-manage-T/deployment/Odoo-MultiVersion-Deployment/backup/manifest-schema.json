{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Odoo Backup Manifest Schema",
  "description": " Schema لملف معلومات النسخة الاحتياطية (manifest.json)",
  "type": "object",
  "required": [
    "backup_id",
    "odoo_version",
    "postgres_version",
    "instance",
    "database",
    "backup_type",
    "created_at",
    "database_backup",
    "filestore_backup",
    "addons_backup",
    "config_backup",
    "integrity_check",
    "status"
  ],
  "properties": {
    "backup_id": {
      "type": "string",
      "description": "معرف فريد للنسخة الاحتياطية",
      "pattern": "^odoo(17|18|19)-(instance1|instance2)-\\d{8}$",
      "example": "odoo17-instance1-20261104"
    },
    "odoo_version": {
      "type": "string",
      "enum": ["17", "18", "19"],
      "description": "إصدار Odoo",
      "example": "17"
    },
    "postgres_version": {
      "type": "string",
      "enum": ["16", "17", "18"],
      "description": "إصدار PostgreSQL",
      "example": "16"
    },
    "instance": {
      "type": "string",
      "enum": ["instance1", "instance2"],
      "description": "اسم النسخة (instance)",
      "example": "instance1"
    },
    "database": {
      "type": "string",
      "description": "اسم قاعدة البيانات",
      "example": "odoo17_db1"
    },
    "backup_type": {
      "type": "string",
      "enum": ["full", "database", "filestore", "configuration", "complete-infrastructure", "pre-update"],
      "description": "نوع النسخ الاحتياطي",
      "example": "full"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "تاريخ ووقت إنشاء النسخة",
      "example": "2026-11-04T02:00:00+02:00"
    },
    "database_backup": {
      "type": "string",
      "description": "اسم ملف نسخة قاعدة البيانات",
      "example": "database.dump"
    },
    "filestore_backup": {
      "type": "string",
      "description": "اسم ملف نسخة المرفقات (Filestore)",
      "example": "filestore.tar.zst"
    },
    "addons_backup": {
      "type": "string",
      "description": "اسم ملف نسخة الإضافات المخصصة",
      "example": "addons.tar.zst"
    },
    "config_backup": {
      "type": "string",
      "description": "اسم ملف نسخة إعدادات Odoo",
      "example": "config.tar.zst"
    },
    "integrity_check": {
      "type": "string",
      "enum": ["sha256", "md5", "none"],
      "description": "خوارزمية التحقق من السلامة المستخدمة",
      "example": "sha256"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "in_progress"],
      "description": "حالة عملية النسخ الاحتياطي",
      "example": "completed"
    },
    "git_commit": {
      "type": "string",
      "description": "رقم Commit في Git المستخدم في النشر",
      "pattern": "^[0-9a-f]{5,40}$",
      "example": "a1b2c3d4e5f6"
    },
    "git_tag": {
      "type": "string",
      "description": "العلامة (tag) في Git المستخدم في النشر",
      "example": "v1.0.0"
    },
    "storage_location": {
      "type": "string",
      "description": "موقع تخزين النسخة الاحتياطية",
      "example": "/data/backups/odoo17/instance1/2026-11-04_020000"
    },
    "checksums_file": {
      "type": "string",
      "description": "اسم ملف التحقق من السلامة",
      "example": "checksums.sha256"
    },
    "notes": {
      "type": "string",
      "description": "ملاحظات إضافية حول النسخة",
      "example": "نسخة احتياطية دورية قبل التحديث"
    }
  },
  "additionalProperties": false
}