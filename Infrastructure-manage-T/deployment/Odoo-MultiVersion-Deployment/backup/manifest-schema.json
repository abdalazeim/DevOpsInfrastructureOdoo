{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Odoo Backup Manifest Schema",
  "description": " Schema for backup manifest file (manifest.json)",
  "type": "object",
  "required": [
    "backup_id",
    "odoo_version",
    "postgres_version",
    "instance",
    "database",
    "backup_type",
    "created_at",
    "database_backup",
    "filestore_backup",
    "addons_backup",
    "config_backup",
    "integrity_check",
    "status"
  ],
  "properties": {
    "backup_id": {
      "type": "string",
      "description": "Unique backup identifier",
      "pattern": "^odoo(17|18|19)-(instance1|instance2)-\\d{8}$",
      "example": "odoo17-instance1-20261104"
    },
    "odoo_version": {
      "type": "string",
      "enum": ["17", "18", "19"],
      "description": "Odoo version",
      "example": "17"
    },
    "postgres_version": {
      "type": "string",
      "enum": ["16", "17", "18"],
      "description": "PostgreSQL version",
      "example": "16"
    },
    "instance": {
      "type": "string",
      "enum": ["instance1", "instance2"],
      "description": "Instance name",
      "example": "instance1"
    },
    "database": {
      "type": "string",
      "description": "Database name",
      "example": "odoo17_db1"
    },
    "backup_type": {
      "type": "string",
      "enum": ["full", "database", "filestore", "configuration", "complete-infrastructure", "pre-update"],
      "description": "Backup type",
      "example": "full"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Backup creation date and time",
      "example": "2026-11-04T02:00:00+02:00"
    },
    "database_backup": {
      "type": "string",
      "description": "Database backup file name",
      "example": "database.dump"
    },
    "filestore_backup": {
      "type": "string",
      "description": "Filestore backup file name",
      "example": "filestore.tar.zst"
    },
    "addons_backup": {
      "type": "string",
      "description": "Custom addons backup file name",
      "example": "addons.tar.zst"
    },
    "config_backup": {
      "type": "string",
      "description": "Odoo configuration backup file name",
      "example": "config.tar.zst"
    },
    "integrity_check": {
      "type": "string",
      "enum": ["sha256", "md5", "none"],
      "description": "Integrity check algorithm used",
      "example": "sha256"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "in_progress"],
      "description": "Backup operation status",
      "example": "completed"
    },
    "git_commit": {
      "type": "string",
      "description": "Git commit hash used for deployment",
      "pattern": "^[0-9a-f]{5,40}$",
      "example": "a1b2c3d4e5f6"
    },
    "git_tag": {
      "type": "string",
      "description": "Git tag used for deployment",
      "example": "v1.0.0"
    },
    "storage_location": {
      "type": "string",
      "description": "Backup storage location",
      "example": "/data/backups/odoo17/instance1/2026-11-04_020000"
    },
    "checksums_file": {
      "type": "string",
      "description": "Integrity check file name",
      "example": "checksums.sha256"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the backup",
      "example": "Routine backup before update"
    }
  },
  "additionalProperties": false
}