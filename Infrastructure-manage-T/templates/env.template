# ==============================================================================
# Odoo Infrastructure Environment Secrets Configuration Template
# Permissions: chmod 600 .env
# DO NOT COMMIT THIS FILE WITH REAL PASSWORDS TO VERSION CONTROL
#
# bootstrap-odoo-infra.sh copies this file to .env and generates random
# passwords + a Traefik Basic Auth hash automatically.
# ==============================================================================

# General
ODOO_DATA_ROOT="/opt/odoo-infrastructure"
DOCKER_PROXY_NETWORK="proxy"
# Domains are set from centralized HostnameConfig (app/config/hostname_config.py)
ODOO17_DOMAIN="${ODOO17_DOMAIN:-odoo17-1.localhost}"
ODOO18_DOMAIN="${ODOO18_DOMAIN:-odoo18-1.localhost}"
ODOO19_DOMAIN="${ODOO19_DOMAIN:-odoo19-1.localhost}"

# Traefik v3.7
ACME_EMAIL="${ACME_EMAIL:-admin@localhost}"
TRAEFIK_DASHBOARD_DOMAIN="${TRAEFIK_DASHBOARD_DOMAIN:-traefik.localhost}"
# Basic Auth users for the dashboard. Single quotes keep '$' literal.
# Generate with: htpasswd -nb admin 'your_secure_password'
TRAEFIK_BASIC_AUTH='admin:$apr1$902k41p8$examplehash'

# Odoo 17 & PostgreSQL 16
ODOO17_DB_NAME="odoo17_prod"
ODOO17_DB_USER="odoo"
ODOO17_DB_PASSWORD="change_me_to_a_secure_postgres16_password"
ODOO17_ADMIN_PASSWORD="change_me_to_a_secure_odoo17_master_password"

# Odoo 18 & PostgreSQL 17
ODOO18_DB_NAME="odoo18_prod"
ODOO18_DB_USER="odoo"
ODOO18_DB_PASSWORD="change_me_to_a_secure_postgres17_password"
ODOO18_ADMIN_PASSWORD="change_me_to_a_secure_odoo18_master_password"

# Odoo 19 & PostgreSQL 18
ODOO19_DB_NAME="odoo19_prod"
ODOO19_DB_USER="odoo"
ODOO19_DB_PASSWORD="change_me_to_a_secure_postgres18_password"
ODOO19_ADMIN_PASSWORD="change_me_to_a_secure_odoo19_master_password"

# Backup Settings
BACKUP_RETENTION_COUNT=7

# pgAdmin 4 (Websoft9-style standalone container)
PGADMIN_HTTP_PORT="5050"
PGADMIN_DOMAIN="${PGADMIN_DOMAIN:-pgadmin.localhost}"
PGADMIN_DEFAULT_EMAIL="admin@localhost"
PGADMIN_DEFAULT_PASSWORD="change_me_to_a_secure_pgadmin_password"
