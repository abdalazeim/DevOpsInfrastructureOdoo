version: '3.8'

services:
  odoo{{ odoo_version }}-db:
    image: {{ odoo.database.engine }}
    container_name: odoo{{ odoo_version }}-db
    restart: unless-stopped
    environment:
      - POSTGRES_DB=postgres
      - POSTGRES_USER=${ODOO{{ odoo_version }}_DB_USER:-{{ odoo.database.user }}}
      - POSTGRES_PASSWORD=${ODOO{{ odoo_version }}_DB_PASSWORD}
      - PGDATA=/var/lib/postgresql/data/pgdata
    volumes:
      - {{ paths.data_root }}/odoo{{ odoo_version }}/db_data:/var/lib/postgresql/data/pgdata
    networks:
      - odoo{{ odoo_version }}_internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${ODOO{{ odoo_version }}_DB_USER:-{{ odoo.database.user }}}"]
      interval: 10s
      timeout: 5s
      retries: 5

  odoo{{ odoo_version }}:
    image: {{ odoo.image }}
    container_name: odoo{{ odoo_version }}
    restart: unless-stopped
    depends_on:
      odoo{{ odoo_version }}-db:
        condition: service_healthy
    environment:
      - HOST=odoo{{ odoo_version }}-db
      - USER=${ODOO{{ odoo_version }}_DB_USER:-{{ odoo.database.user }}}
      - PASSWORD=${ODOO{{ odoo_version }}_DB_PASSWORD}
    volumes:
      - ./config/odoo.conf:/etc/odoo/odoo.conf:ro
      - {{ paths.data_root }}/odoo{{ odoo_version }}/data:/var/lib/odoo
      - {{ paths.data_root }}/odoo{{ odoo_version }}/addons:/mnt/extra-addons
    networks:
      - odoo{{ odoo_version }}_internal
      - {{ network.proxy_network_name | default('proxy') }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.odoo{{ odoo_version }}-web.rule=Host(`{{ odoo.domain }}`)"
      - "traefik.http.routers.odoo{{ odoo_version }}-web.entrypoints=websecure"
      - "traefik.http.routers.odoo{{ odoo_version }}-web.tls.certresolver=letsencrypt"
      - "traefik.http.routers.odoo{{ odoo_version }}-web.service=odoo{{ odoo_version }}-svc"
      - "traefik.http.services.odoo{{ odoo_version }}-svc.loadbalancer.server.port=8069"

networks:
  odoo{{ odoo_version }}_internal:
    driver: bridge
    internal: true
  {{ network.proxy_network_name | default('proxy') }}:
    external: true
