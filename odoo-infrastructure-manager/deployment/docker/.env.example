# Copy to deployment/docker/.env for local Compose development.
# Keep credentials local; use unique random values for shared environments.
DEBUG=True
SECRET_KEY=replace-with-a-random-local-development-key

POSTGRES_DB=template_dev
POSTGRES_USER=template_user
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://template_user:replace-with-a-local-password@db:5432/template_dev

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
CORS_ALLOWED_ORIGINS=

RATE_LIMIT_LOGIN=30/m
RATE_LIMIT_API=120/m
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
